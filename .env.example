# Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coed_v2
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/coed_v2_test

# Production secret mode: configure these in Lambda, REMOVE DATABASE_URL there.
# Never put SecretString/password/static AWS credentials in environment or files.
# DB_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:<name>-<suffix>
# DB_HOST=<rds-endpoint>
# DB_PORT=5432
# DB_NAME=coed
# DB_USER=coed_app
# DB_SSL_CA_FILE=/var/task/global-bundle.pem
# Packaging only: COED_RDS_CA_FILE=/absolute/path/to/trusted/global-bundle.pem

# HTTP API
PORT=3000

# Authentication (#58) - use development Cognito values only, never production
AUTH_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
AUTH_AUDIENCE=<cognito-app-client-id>

# TU provider — backend ONLY. Never put keys/passwords in CO_ED_* browser config,
# source, examples, ZIPs or logs. Use a rotated key via the runtime secret store.
# These are two explicitly allowed endpoints; no automatic retry/failover.
# TU_API_URL=https://restapi.tu.ac.th/api/v1/auth/Ad/verify
# Alternative: https://restapi.tu.ac.th/api/v1/auth/Ad/verify2
# Production preferred: a Secrets Manager value, raw or {"TU_API_APP_KEY":"..."}.
# TU_API_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:<name>-<suffix>
# TU_API_APP_KEY=<inject-at-backend-runtime-only>
# Separate application signing keys/DB identity links are still required.
# Split TU broker ONLY (production forbids raw TU_API_APP_KEY and all DB/private-key config):
# TU_SESSION_FUNCTION_ARN=arn:aws:lambda:<region>:<account>:function:coed-tu-session-issuer:live
# TU_AUTH_PUBLIC_KEY=<public-verification-PEM-only>
# TU_AUTH_KEY_ID=tu-key-1
# TU_LOGIN_MAINTENANCE=true
# Private issuer ONLY (not an HTTP/Gateway handler):
# NODE_ENV=production
# DB_USER=coed_tu_login
# DB_POOL_MAX=1
# DB_CONN_TIMEOUT=1000
# DB_QUERY_TIMEOUT=1000
# TU_SIGNING_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:<name>-<suffix>
# Signing SecretString is exactly {"privateKey":"<PEM>","publicKey":"<PEM>"}.
# Never reuse the API writer role/secret, broker TU key or owner credentials here.

# Authenticated frontend shell (#57) - public browser/build values, never add a client secret
CO_ED_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com
CO_ED_COGNITO_USER_POOL_ID=<region>_<user-pool-id>
CO_ED_COGNITO_CLIENT_ID=<public-app-client-id>
CO_ED_COGNITO_DOMAIN=<domain-prefix>.auth.<region>.amazoncognito.com
CO_ED_APP_ORIGIN=https://<amplify-domain>

# Connection Pool Settings
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=2000
DB_QUERY_TIMEOUT=5000

# Seed/Reset Settings
NODE_ENV=development
ALLOW_DB_RESET=false

# Phase 1 private documents (#141). No provider is enabled by default.
# Local provider: development/test ONLY, never Lambda. Keep its directory private.
# CO_ED_APPLICATION_STORAGE=local
# CO_ED_APPLICATION_LOCAL_DIR=<private-local-directory>
# Production: private S3 bucket/IAM/CORS/CSP/network must be reviewed separately.
# CO_ED_APPLICATION_STORAGE=s3
# CO_ED_APPLICATION_BUCKET=<private-bucket-name>
# CO_ED_APPLICATION_REGION=<bucket-region>
# Explicit local disposable target for Phase 1 integration tests (never RDS).
# CO_ED_APPLICATION_TEST_DATABASE_URL=postgresql://<test-user>@127.0.0.1:5432/coed_v4_application_test
