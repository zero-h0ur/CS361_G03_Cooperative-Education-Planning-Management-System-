# Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coed_v2
# For tests, use a separate test database:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/coed_v2_test

# Connection Pool Settings
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=2000
DB_QUERY_TIMEOUT=5000

# Seed/Reset Settings
NODE_ENV=development
ALLOW_DB_RESET=true
