{
  "name": "co-ed-v2",
  "version": "1.0.0",
  "description": "CO-ED V2 Data Access Layer",
  "main": "index.js",
  "engines": {
    "node": ">=18.14.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "build": "node scripts/build-frontend.mjs",
    "migrate": "node src/db/migrate.js",
    "test": "npm run test:dataset && npm run test:fixtures && npm run test:api && npm run test:contract && npm run test:auth && npm run test:authz && npm run test:workflow && npm run test:session && npm run test:profile && npm run test:lambda && npm run test:frontend && npm run test:migration && npm run test:dal",
    "test:api": "jest --runInBand tests/api.test.js",
    "test:contract": "jest --runInBand tests/v3-api-contract.test.js",
    "test:auth": "jest --runInBand tests/auth-context.test.js",
    "test:authz": "jest --runInBand tests/authorization.test.js",
    "test:workflow": "jest --runInBand tests/workflow-service.test.js",
    "test:session": "jest --runInBand tests/session-me.test.js",
    "test:profile": "jest --runInBand tests/student-profile.test.js",
    "test:lambda": "jest --runInBand tests/lambda.test.js",
    "test:dataset": "node --test tests/v2-dataset.test.mjs",
    "test:fixtures": "node --test tests/v3-dataset.test.mjs && jest --runInBand tests/v3-fixtures.test.js",
    "test:dal": "jest --runInBand tests/dal.test.js",
    "test:frontend": "node scripts/build-frontend-test-modules.mjs && jest --runInBand tests/company-directory.test.js tests/authenticated-session.test.js tests/authenticated-shell.test.js tests/login-logout-session-ux.test.js",
    "test:migration": "jest --runInBand tests/v3-migration.test.js",
    "test:deployment": "node --test tests/deployed-v2.test.mjs",
    "seed": "node src/db/seed.js",
    "seed:v3": "node src/db/seed.js --v3",
    "seed:v2": "node src/db/seed.js --v2-only"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "aws-amplify": "^6.22.2",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  }
}
