{
  "name": "co-ed-v2",
  "version": "1.0.0",
  "description": "CO-ED V2 Data Access Layer",
  "main": "index.js",
  "engines": {
    "node": ">=18.14.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "npm run test:dataset && npm run test:api && npm run test:contract && npm run test:auth && npm run test:authz && npm run test:session && npm run test:lambda && npm run test:frontend && npm run test:migration && npm run test:dal",
    "test:api": "jest --runInBand tests/api.test.js",
    "test:contract": "jest --runInBand tests/v3-api-contract.test.js",
    "test:auth": "jest --runInBand tests/auth-context.test.js",
    "test:authz": "jest --runInBand tests/authorization.test.js",
    "test:session": "jest --runInBand tests/session-me.test.js",
    "test:lambda": "jest --runInBand tests/lambda.test.js",
    "test:dataset": "node --test tests/v2-dataset.test.mjs",
    "test:dal": "jest --runInBand tests/dal.test.js",
    "test:frontend": "jest --runInBand tests/company-directory.test.js",
    "test:migration": "jest --runInBand tests/v3-migration.test.js",
    "test:deployment": "node --test tests/deployed-v2.test.mjs",
    "seed": "node src/db/seed.js"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  }
}
